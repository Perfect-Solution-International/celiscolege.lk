# Public site URL - used for canonical URLs, sitemap.xml, robots.txt and OG tags.
NEXT_PUBLIC_SITE_URL=https://celiscollege.lk

# Google Search Console verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Where contact / application form submissions are emailed.
# Leave SMTP_HOST empty to skip email and only append to data/submissions.jsonl.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=info@celiscollege.lk
CONTACT_FROM=website@celiscollege.lk
